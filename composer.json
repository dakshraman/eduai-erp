{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
      "framework",
      "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "africastalking/africastalking": "v3.0.0",
    "anhskohbo/no-captcha": "^3.2",
    "ashallendesign/email-utilities": "^1.2",
    "barryvdh/laravel-dompdf": "^3.1.1",
    "brian2694/laravel-toastr": "^5.53",
    "fakerphp/faker": "^1.24",
    "google/apiclient": "^2.12",
    "guzzlehttp/guzzle": "^6.0|^7.2.0",
    "intervention/image": "^2.5",
    "ixudra/curl": "^6.22",
    "jenssegers/agent": "^2.6",
    "joisarjignesh/bigbluebutton": "dev-master",
    "laravel/framework": "^13.0",
    "laravel/octane": "*",
    "laravel/passport": "^v13.7.5",
    "laravel/pulse": "^1.4",
    "laravel/reverb": "*",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "laravelcollective/html": "^6.1",
    "league/omnipay": "^3.2",
    "maatwebsite/excel": "^3.1",
    "mercadopago/dx-php": "^2.4",
    "nwidart/laravel-modules": "^8.2",
    "omnipay/paypal": "^3.0",
    "php-http/message": "^1.16",
    "php-http/message-factory": "^1.1",
    "phpmailer/phpmailer": "^6.0",
    "pusher/pusher-php-server": "^7.2",
    "rahulreghunath/textlocal": "^1.0",
    "silviolleite/laravelpwa": "^2.0",
    "simplesoftwareio/simple-qrcode": "~4",
    "spatie/db-dumper": "^3.8",
    "spatie/laravel-html": "^3.11",
    "spatie/valuestore": "^1.2",
    "spiral/roadrunner-cli": "^2.6.0",
    "spiral/roadrunner-http": "^3.3.0",
    "spondonit/laravel-fcm-notification": "^1.0.1",
    "spondonit/rpclient": "^1.0",
    "spondonit/school-service": "^2.0.1",
    "stripe/stripe-php": "^7.37",
    "symfony/polyfill-php70": "^1.18.1",
    "tarsoft/toyyibpay": "dev-master",
    "twilio/sdk": "^5.31",
    "unicodeveloper/laravel-paystack": "dev-dev-13-compatibility",
    "vimeo/laravel": "^5.11.0",
    "xendit/xendit-php": "^2.10",
    "yajra/laravel-datatables-oracle": "^13.0"
  },
  "require-dev": {
    "brianium/paratest": "^7.20",
    "fruitcake/laravel-debugbar": "^4.2.8",
    "larastan/larastan": "^3.1",
    "laravel/boost": "^2.0",
    "laravel/dusk": "^8.0",
    "laravel/pint": "^1.21",
    "laravel/sail": "^1.14",
    "laravel/ui": "^4.6.1",
    "mockery/mockery": "^1.3.1",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0",
    "spatie/laravel-ignition": "^2.0",
    "spiral/roadrunner": "^2025.1"
  },
  "config": {
      "optimize-autoloader": true,
      "preferred-install": "dist",
      "sort-packages": true,
      "allow-plugins": {
          "php-http/discovery": true
      }
  },
  "extra": {
      "laravel": {
          "dont-discover": [
              "laravel/telescope"
          ]

      },
      "google/apiclient-services": [
          "Calendar","Oauth2","Drive"
      ]
  },
  "autoload": {
      "classmap": [
          "database",
        "Modules/*/Database"
      ],
      "psr-4": {
          "App\\": "app/",
          "Tests\\": "tests/",
          "Modules\\": "Modules/",
          "Database\\Factories\\": "database/factories/",
          "Database\\Seeders\\": "database/seeders/",
          "Larabuild\\Pagebuilder\\": "packages/larabuild/pagebuilder/src/",
          "Larabuild\\Optionbuilder\\": "packages/larabuild/optionbuilder/src/"
      },
      "files": [
        "app/Helpers/Helper.php",
        "app/Helpers/saas.php",
        "app/Helpers/FeesHelper.php",
        "app/Helpers/ExamHelper.php",
        "app/Helpers/Basic.php",
        "app/Helpers/SmsHelper.php",
        "app/Helpers/EmailHelper.php"
      ]
  },
  "autoload-dev": {
      "psr-4": {
          "Tests\\": "tests/"

      }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
      "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
      "post-autoload-dump": [
          "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
          "@php artisan package:discover --ansi"
      ],
      "post-root-package-install": [
          "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
      ],
      "post-create-project-cmd": [
          "@php artisan key:generate --ansi"
      ],
      "lint": "pint",
      "refactor": "rector",
      "test:lint": "pint --test",
      "test:refactor": "rector --dry-run",
      "test": [
          "@test:lint",
          "@test:refactor"
      ]
  },
  "repositories": {
      "optionbuilder": {
          "type": "path",
          "url": "packages/larabuild/optionbuilder",
          "options": {
              "symlink": false
          }
      },
      "pageubilder": {
          "type": "path",
          "url": "packages/larabuild/pagebuilder",
          "options": {
              "symlink": false
          }
      },

      "aora-paystack" : {
          "type": "vcs",
          "url": "https://github.com/aoradev44/laravel-paystack.git"
      },

    "aora-bigbluebutton" : {
      "type": "vcs",
      "url": "https://github.com/aoradev44/bigbluebutton.git"
    },
      "aora-toyyibpay" : {
          "type": "vcs",
          "url": "https://github.com/aoradev44/toyyibpay-laravel.git"
      },
      "aora-html" : {
          "type": "vcs",
          "url": "https://github.com/aoradev44/html.git"
      }

  }
}
